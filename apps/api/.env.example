PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/aurora-commerce
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_RESPONSE_MODEL=gpt-5.4-mini
MONGODB_VECTOR_INDEX=products_embedding_index
ADMIN_EMAIL=admin@aurora.local
ADMIN_PASSWORD=change-me
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret

# AI Provider Configuration (openai | bedrock | local)
RESPONSE_PROVIDER=local

# AWS Bedrock Configuration
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_RESPONSE_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
